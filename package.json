{
  "name": "mailsorta-open-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker 邮件整理服务：接入 Gmail / Outlook / Agently Mail(QQ)，按规则提取字段入库，前端查询并导出 Excel",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node scripts/setup.mjs",
    "scan:secrets": "node scripts/formal_secret_scan.mjs",
    "hash:password": "node scripts/gen-password-hash.mjs",
    "key:generate": "node scripts/gen-encryption-key.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "imapflow": "^1.7.8",
    "md5": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/md5": "^2.3.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
